# Salin ke .env (tidak masuk repo). Lihat docs/PRD-v2.md §3, §6, §9.

# Database
POSTGRES_USER=csm
POSTGRES_PASSWORD=ganti-password-lokal
POSTGRES_DB=csm
DB_PORT=5433
DATABASE_URL=postgresql://csm:ganti-password-lokal@localhost:5433/csm

# URL publik (produksi: https://csm.namaperusahaan.co.id)
PUBLIC_URL=http://localhost:3000
API_PORT=4000

# Mode login: `password` (sementara) atau `google` (PRD §3, wajib sebelum go-live)
AUTH_MODE=password

# Akun awal untuk AUTH_MODE=password — isi di .env lokal saja, JANGAN di file ini (repo publik)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Google OAuth (hanya openid email profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAINS=namaperusahaan.co.id

# Sesi (JWT access 15 menit, refresh 7 hari)
JWT_SECRET=ganti-dengan-string-acak-panjang

# Enkripsi kolom (pgcrypto) dan blind index HMAC — dua kunci berbeda
PII_ENCRYPTION_KEY=ganti-kunci-enkripsi
PII_BIDX_KEY=ganti-kunci-hmac

# Hugging Face Inference Providers — HANYA untuk service ml, jangan pernah di env Next.js
HF_TOKEN=
HF_MODEL=Qwen/Qwen3.5-397B-A17B
HF_PROVIDER=
