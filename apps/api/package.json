{
  "name": "@csm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "wilayah:import": "tsx --env-file-if-exists=../../.env scripts/import-wilayah.ts",
    "spike:excel": "tsx scripts/spike-excel.ts",
    "user:create": "tsx --env-file-if-exists=../../.env scripts/create-user.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "users:seed": "tsx --env-file-if-exists=../../.env scripts/seed-users.ts"
  },
  "dependencies": {
    "@csm/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jszip": "^3.10.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.2"
  }
}
